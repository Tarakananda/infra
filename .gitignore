# Terraform working directories and local state (may contain secrets)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
.terraform-data/

# Keep .terraform.lock.hcl tracked for reproducible provider versions.

# Saved plans and JSON exports (may contain secrets)
tfplan
tfplan.*
*.tfplan
*.tfplan.*
*.plan
*.plan.json

# Local variable values; commit only sanitized examples
*.tfvars
*.tfvars.json
!example.tfvars
!example.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform crash logs and local overrides
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration and credentials
.terraformrc
terraform.rc
credentials.tfrc.json

# Environment secrets and local cloud/Kubernetes credentials
.env
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.kube/
kubeconfig
kubeconfig.*
*.kubeconfig
*.pem
*.key
*.p12
*.pfx

# Python runtime, virtual environments, and tooling caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# OS and editor files
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

